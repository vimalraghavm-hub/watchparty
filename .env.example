# Supabase Configuration
# Replace these with your actual Supabase project URL and Anon (public) key
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# WebRTC STUN / TURN Configuration
# STUN servers (comma separated)
VITE_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Optional TURN Relay Configuration (for strict symmetric NATs)
# Format: turn:turn.example.com:3478 or turns:turn.example.com:5349
VITE_TURN_SERVERS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Storage settings
VITE_MAX_UPLOAD_SIZE_MB=500
